<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" rel="stylesheet">
  <title>WhatsApp Dashboard</title>
  <style>
    body {
      background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
      color: #e6e6e6;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1 {
      color: #ffffff;
    }

    .card {
      background-color: #1e2a38;
      border: none;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
    }

    .card-header {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .btn {
      border-radius: 50px;
    }

    .btn-primary {
      background: linear-gradient(to right, #56ccf2, #2f80ed);
      border: none;
    }

    .btn-secondary {
      background: linear-gradient(to right, #667eea, #764ba2);
      border: none;
    }

    .btn-danger {
      background: linear-gradient(to right, #ff758c, #ff7eb3);
      border: none;
    }

    .list-group-item {
      background-color: #1e2a38;
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #d1d1d1;
    }

    .list-group-item button {
      background: linear-gradient(to right, #ff758c, #ff7eb3);
      border: none;
      border-radius: 50px;
      color: white;
    }

    .modal-content {
      background-color: #1e2a38;
      color: #e6e6e6;
    }

    #qr-code {
      animation: fadeIn 1s ease-in-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  </style>
</head>
<body>
  <div class="container mt-5">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center">
      <h1><i class="bi bi-whatsapp me-2"></i> WhatsApp Dashboard</h1>
      <form action="/logout-user" method="POST">
        <button class="btn btn-danger">
          <i class="bi bi-box-arrow-right"></i> Logout
        </button>
      </form>
    </div>

    <!-- Status Section -->
    <div class="alert alert-dark mt-3 d-flex justify-content-between align-items-center" role="alert">
      <span>
        <i class="bi bi-info-circle-fill me-2"></i>Status: <span id="status-text" class="fw-bold"><%= status %></span>
      </span>
      <div id="status-spinner" class="spinner-border spinner-border-sm text-light" role="status">
        <span class="visually-hidden">Loading...</span>
      </div>
    </div>

    <!-- Main Content Section -->
    <div class="row mt-4">
        <div class="col-md-6">
        <div class="card">
          <div class="card-header text-white">
            <i class="bi bi-qr-code-scan card-header-icon"></i> QR Code
          </div>
          <div class="card-body text-center">
            <% if (qr) { %>
              <img id="qr-code" src="<%= qr %>" alt="QR Code" class="img-fluid" style="max-width: 300px;">
            <% } else { %>
              <p class="text-muted">QR Code not available. Try refreshing.</p>
            <% } %>
          </div>
        </div>
      </div>
      <!-- Connected Devices Section -->
      <div class="col-md-6">
      <div class="col-md-12">
        <div class="card">
          <div class="card-header text-white">
            <i class="bi bi-laptop card-header-icon"></i> Connected Devices
          </div>
          <div class="card-body">
            <% if (devices.length > 0) { %>
              <ul class="list-group">
                <% devices.forEach((device) => { %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <%= device.name %> (<%= device.id %>)
                    <button class="btn btn-danger btn-sm" onclick="removeDevice('<%= device.id %>')">
                      <i class="bi bi-trash"></i> Remove
                    </button>
                  </li>
                <% }) %>
              </ul>
            <% } else { %>
              <p class="text-white">No connected devices.</p>
            <% } %>
          </div>
        </div>
      </div>
       <!-- Quick Actions Section -->
      <div class="col-md-12 mt-4">
        <div class="card">
          <div class="card-header text-white">
            <i class="bi bi-lightning-charge card-header-icon"></i> Quick Actions
          </div>
          <div class="card-body">
            <button class="btn btn-primary w-100 mb-3" data-bs-toggle="modal" data-bs-target="#sendNotificationModal">
              <i class="bi bi-send"></i> Send Notification
            </button>
            <button class="btn btn-secondary w-100 mb-3" onclick="refreshQR()">
              <i class="bi bi-arrow-clockwise"></i> Refresh QR Code
            </button>
            <button class="btn btn-danger w-100" id="logout-whatsapp-btn">
              <i class="bi bi-box-arrow-left"></i> Logout WhatsApp
            </button>
          </div>
        </div>
      </div>
      </div>





    </div>
     <!-- Server Status Section -->
         <div class="row mt-4">
      <div class="col-md-6">
        <div class="card">
          <div class="card-header text-white">
            <i class="bi bi-server card-header-icon"></i> Server Status
          </div>
          <div class="card-body text-white">
            <p id="server-uptime"></p>
            <p id="server-memory"></p>
            <p id="server-connections"></p>
          </div>
        </div>
      </div>
        <div class="col-md-6">
            <div class="card">
            <div class="card-header text-white">
                <i class="bi bi-file-earmark-text card-header-icon"></i> Server Logs
            </div>
            <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                <ul id="logs-list" class="list-group">
                <!-- Logs will be dynamically loaded here -->
                </ul>
            </div>
            </div>
        </div>
        </div>

    <!-- QR Code Section -->
    <div class="row mt-4">

    </div>


  </div>

  <!-- Send Notification Modal -->
  <div class="modal fade" id="sendNotificationModal" tabindex="-1" aria-labelledby="sendNotificationModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="sendNotificationModalLabel">
            <i class="bi bi-send"></i> Send Notification
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="sendNotificationForm">
            <div class="mb-3">
              <label for="phoneNumber" class="form-label">Phone Number</label>
              <input type="text" class="form-control" id="phoneNumber" required>
            </div>
            <div class="mb-3">
              <label for="message" class="form-label">Message</label>
              <textarea class="form-control" id="message" rows="3" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-100">Send</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const ws = new WebSocket('wss://' + window.location.host);

    ws.onmessage = (event) => {
      const data = JSON.parse(event.data);
      if (data.event === 'qr') {
        document.getElementById('qr-code').src = data.data;
        Swal.fire('QR Code Updated', 'The QR code has been refreshed.', 'info');
      }
      if (data.event === 'status') {
        document.getElementById('status-text').innerText = data.data.status;
      }
    };

    function fetchServerStatus() {
      fetch('/api/server-status')
        .then((res) => res.json())
        .then((data) => {
          document.getElementById('server-uptime').innerText = `Uptime: ${Math.floor(data.uptime / 60)} minutes`;
          document.getElementById('server-memory').innerText = `Memory Usage: ${(data.memoryUsage.heapUsed / 1024 / 1024).toFixed(2)} MB`;
          document.getElementById('server-connections').innerText = `Active Connections: ${data.connections}`;
        });
    }

     function fetchServerLogs() {
    fetch('/api/server-logs')
      .then((res) => res.json())
      .then((data) => {
        const logsList = document.getElementById('logs-list');
        logsList.innerHTML = ''; // Clear existing logs
        if (data.logs && data.logs.length > 0) {
          data.logs.forEach((log) => {
            const logItem = document.createElement('li');
            logItem.className = 'list-group-item';
            logItem.textContent = log;
            logsList.appendChild(logItem);
          });
        } else {
          const noLogsItem = document.createElement('li');
          noLogsItem.className = 'list-group-item text-muted';
          noLogsItem.textContent = 'No logs available.';
          logsList.appendChild(noLogsItem);
        }
      })
      .catch(() => {
        Swal.fire('Error', 'Failed to fetch server logs.', 'error');
      });
  }

    // Refresh QR Code
    function refreshQR() {
      fetch('/qr')
        .then(response => response.json())
        .then(data => {
          if (data.qr) {
            document.getElementById('qr-code').src = data.qr;
            Swal.fire('QR Code Refreshed', 'The QR code has been updated.', 'success');
          } else {
            Swal.fire('Error', 'QR Code not available.', 'error');
          }
        })
        .catch(err => Swal.fire('Error', 'Failed to refresh QR Code.', 'error'));
    }

    // Logout WhatsApp
    document.getElementById('logout-whatsapp-btn').addEventListener('click', () => {
      Swal.fire({
        title: 'Are you sure?',
        text: "This will log out WhatsApp and restart the connection.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, log out!',
        cancelButtonText: 'Cancel',
      }).then((result) => {
        if (result.isConfirmed) {
          fetch('/logout', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
            .then(response => response.json())
            .then(data => {
              if (data.status === 'success') {
                Swal.fire('Logged Out', data.message, 'success').then(() => location.reload());
              } else {
                Swal.fire('Error', data.error || 'Failed to log out.', 'error');
              }
            })
            .catch(() => Swal.fire('Error', 'An error occurred while logging out.', 'error'));
        }
      });
    });

    // Send Notification
    document.getElementById('sendNotificationForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const phoneNumber = document.getElementById('phoneNumber').value;
      const message = document.getElementById('message').value;

      fetch('/send-notification', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ phoneNumber, message }),
      })
        .then(response => response.json())
        .then(data => {
          if (data.message) {
            Swal.fire('Success', data.message, 'success');
            document.getElementById('sendNotificationForm').reset();
          } else {
            Swal.fire('Error', data.error || 'Failed to send notification.', 'error');
          }
        })
        .catch(() => Swal.fire('Error', 'An error occurred while sending the notification.', 'error'));
    });

    // Remove Device
    function removeDevice(deviceId) {
      Swal.fire({
        title: 'Are you sure?',
        text: 'This will remove the device from the connected list.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Yes, remove it!',
        cancelButtonText: 'Cancel',
      }).then((result) => {
        if (result.isConfirmed) {
          fetch(`/devices/${deviceId}`, { method: 'POST' })
            .then(() => {
              Swal.fire('Removed', 'The device has been removed.', 'success').then(() => location.reload());
            })
            .catch(() => Swal.fire('Error', 'An error occurred while removing the device.', 'error'));
        }
      });
    }
    fetchServerStatus();
    setInterval(fetchServerStatus, 5000); // Refresh every 5 seconds

    // Fetch logs initially and refresh every 10 seconds
    fetchServerLogs();
    setInterval(fetchServerLogs, 10000); // Refresh every 10 seconds

  </script>
</body>
</html>
