<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <title>Server Documentation</title>
  <style>
    body {
      background: linear-gradient(to right, #0f2027, #203a43, #2c5364);
      color: #e6e6e6;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    h1, h2 {
      color: #ffffff;
    }

    .card {
      background-color: #1e2a38;
      border: none;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
      margin-bottom: 1.5rem;
    }

    .card-header {
      background: linear-gradient(to right, #667eea, #764ba2);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      color: white;
    }

    pre {
      background-color: #2c3e50;
      color: #ecf0f1;
      padding: 15px;
      border-radius: 5px;
      overflow-x: auto;
    }

    .btn {
      border-radius: 50px;
    }

    .btn-primary {
      background: linear-gradient(to right, #56ccf2, #2f80ed);
      border: none;
    }

    .btn-primary:hover {
      background: linear-gradient(to right, #2f80ed, #56ccf2);
    }

    .collapse .card-body {
      animation: fadeIn 0.5s;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  </style>
</head>
<body>

  <div class="container mt-5">
 <div class="d-flex justify-content-between align-items-center">
  <h1><i class="bi bi-book"></i> Server Documentation</h1>
    <p class="text-white">Explore the features, endpoints, and functionality of the application.</p>
 <a href="/login" class="btn btn-success">
          <i class="bi bi-box-arrow-right"></i> Login
        </a>
    </div>

    <!-- Overview -->
    <div class="card text-white">
      <div class="card-header">
        <h2 class="h5"><i class="bi bi-info-circle"></i> Overview</h2>
      </div>
      <div class="card-body">
        <p>This application is a WhatsApp management tool built with Express.js. It includes features like QR code generation, WebSocket communication, authentication, and real-time dashboard updates.</p>
      </div>
    </div>

    <!-- Features Section -->
    <div class="card text-white">
      <div class="card-header">
        <h2 class="h5"><i class="bi bi-lightning"></i> Features</h2>
      </div>
      <div class="card-body">
        <ul>
          <li>Real-time WhatsApp session management with QR code generation.</li>
          <li>User authentication and session management.</li>
          <li>REST API for sending notifications and fetching server status/logs.</li>
          <li>WebSocket integration for live updates.</li>
          <li>Graceful shutdown and reconnect functionality.</li>
        </ul>
      </div>
    </div>

    <!-- Endpoints Section -->
    <div class="card text-white">
      <div class="card-header">
        <h2 class="h5"><i class="bi bi-code-slash"></i> API Endpoints</h2>
      </div>
      <div class="card-body">
        <!-- QR Code Endpoint -->
        <button class="btn btn-primary w-100 mb-3" data-bs-toggle="collapse" data-bs-target="#qrEndpoint">
          <i class="bi bi-qr-code"></i> /qr Endpoint
        </button>
        <div class="collapse" id="qrEndpoint">
          <div class="card-body">
            <h5>GET /qr</h5>
            <p>Fetches the latest QR code for WhatsApp authentication.</p>
            <pre><code>{
  "qr": "data:image/png;base64,..."
}</code></pre>
          </div>
        </div>

        <!-- Server Status Endpoint -->
        <button class="btn btn-primary w-100 mb-3" data-bs-toggle="collapse" data-bs-target="#statusEndpoint">
          <i class="bi bi-bar-chart"></i> /api/server-status
        </button>
        <div class="collapse" id="statusEndpoint">
          <div class="card-body">
            <h5>GET /api/server-status</h5>
            <p>Fetches server uptime, memory usage, and WebSocket connections.</p>
            <pre><code>{
  "uptime": 12345,
  "load": [0.12, 0.34, 0.56],
  "memoryUsage": {
    "rss": 12345678,
    "heapTotal": 1234567,
    "heapUsed": 123456
  },
  "connections": 5,
  "status": "Connected"
}</code></pre>
          </div>
        </div>

        <!-- Send Notification Endpoint -->
        <button class="btn btn-primary w-100 mb-3" data-bs-toggle="collapse" data-bs-target="#notificationEndpoint">
          <i class="bi bi-send"></i> /send-notification Endpoint
        </button>
        <div class="collapse" id="notificationEndpoint">
          <div class="card-body">
            <h5>POST /send-notification</h5>
            <p>Sends a message to a specified WhatsApp number.</p>
            <pre><code>{
  "phoneNumber": "+1234567890",
  "message": "Hello, World!"
}</code></pre>
          </div>
        </div>

        <!-- Server Logs Endpoint -->
        <button class="btn btn-primary w-100 mb-3" data-bs-toggle="collapse" data-bs-target="#logsEndpoint">
          <i class="bi bi-file-earmark-text"></i> /api/server-logs Endpoint
        </button>
        <div class="collapse" id="logsEndpoint">
          <div class="card-body">
            <h5>GET /api/server-logs</h5>
            <p>Fetches server logs for debugging and analysis.</p>
            <pre><code>{
  "logs": [
    "Server started...",
    "WhatsApp connected.",
    "New message received."
  ]
}</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Authentication -->
    <div class="card text-white">
      <div class="card-header">
        <h2 class="h5"><i class="bi bi-shield-lock"></i> Authentication</h2>
      </div>
      <div class="card-body">
        <p>Users must log in with valid credentials to access protected routes. Sessions are managed using `express-session`.</p>
        <pre><code>POST /login
{
  "email": "admin@whatsapp.com",
  "password": "admin123"
}</code></pre>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
